+// Native credentials stay on the HarmonyOS side. Only public profile data is supplied here.
+interface ArkForgeAccountProfile { login: string; avatar?: string; }
+let arkforgeAccountProfile: ArkForgeAccountProfile | undefined;
+const arkforgeAccountProfileChanged = new Emitter<void>();
+CommandsRegistry.registerCommand('_arkforge.setAccountProfile', (_accessor, profile?: ArkForgeAccountProfile) => {
+	if (profile && (typeof profile.login !== 'string' || !/^[a-zA-Z0-9-]{1,39}$/.test(profile.login))) {
+		throw new Error('Invalid GitHub account profile');
+	}
+	if (profile?.avatar && !/^https:\/\/avatars\.githubusercontent\.com\/u\/\d+(?:\?[^#]*)?$/.test(profile.avatar)) {
+		throw new Error('Invalid GitHub avatar URL');
+	}
+	arkforgeAccountProfile = profile;
+	arkforgeAccountProfileChanged.fire();
+});
