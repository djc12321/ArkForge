extern "C" __attribute__((unused)) Es2pandaAstNodeFlags IrToE2pAstNodeFlags(ir::AstNodeFlags irFlags)
{
    Es2pandaAstNodeFlags e2pFlags {(Es2pandaAstNodeFlags)0U};
    e2pFlags = static_cast<Es2pandaAstNodeFlags>((irFlags & ir::AstNodeFlags::NO_OPTS) != 0 ? e2pFlags | Es2pandaAstNodeFlags::AST_NODE_FLAGS_NO_OPTS : e2pFlags);
    e2pFlags = static_cast<Es2pandaAstNodeFlags>((irFlags & ir::AstNodeFlags::REST_ARGUMENT) != 0 ? e2pFlags | Es2pandaAstNodeFlags::AST_NODE_FLAGS_REST_ARGUMENT : e2pFlags);
    e2pFlags = static_cast<Es2pandaAstNodeFlags>((irFlags & ir::AstNodeFlags::ALLOW_REQUIRED_INSTANTIATION) != 0 ? e2pFlags | Es2pandaAstNodeFlags::AST_NODE_FLAGS_ALLOW_REQUIRED_INSTANTIATION : e2pFlags);
    e2pFlags = static_cast<Es2pandaAstNodeFlags>((irFlags & ir::AstNodeFlags::GENERATE_VALUE_OF) != 0 ? e2pFlags | Es2pandaAstNodeFlags::AST_NODE_FLAGS_GENERATE_VALUE_OF : e2pFlags);
    e2pFlags = static_cast<Es2pandaAstNodeFlags>((irFlags & ir::AstNodeFlags::RECHECK) != 0 ? e2pFlags | Es2pandaAstNodeFlags::AST_NODE_FLAGS_RECHECK : e2pFlags);
    e2pFlags = static_cast<Es2pandaAstNodeFlags>((irFlags & ir::AstNodeFlags::NOCLEANUP) != 0 ? e2pFlags | Es2pandaAstNodeFlags::AST_NODE_FLAGS_NOCLEANUP : e2pFlags);
    e2pFlags = static_cast<Es2pandaAstNodeFlags>((irFlags & ir::AstNodeFlags::DEFAULT_PARAM) != 0 ? e2pFlags | Es2pandaAstNodeFlags::AST_NODE_FLAGS_DEFAULT_PARAM : e2pFlags);
    e2pFlags = static_cast<Es2pandaAstNodeFlags>((irFlags & ir::AstNodeFlags::IS_GROUPED) != 0 ? e2pFlags | Es2pandaAstNodeFlags::AST_NODE_FLAGS_IS_GROUPED : e2pFlags);
    e2pFlags = static_cast<Es2pandaAstNodeFlags>((irFlags & ir::AstNodeFlags::NO_DEBUG_LINE_INFO) != 0 ? e2pFlags | Es2pandaAstNodeFlags::AST_NODE_FLAGS_NO_DEBUG_LINE_INFO : e2pFlags);
    return e2pFlags;
}

