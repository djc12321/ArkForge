/* Updater */
extern "C" es2panda_AstNode *UpdateVariableDeclaration([[maybe_unused]] es2panda_Context *context, es2panda_AstNode *original
, [[maybe_unused]] Es2pandaVariableDeclarationKind kind, [[maybe_unused]] es2panda_AstNode **declarators, size_t declaratorsLen)
{
{
    auto *prog = const_cast<parser::Program *>(reinterpret_cast<ir::AstNode *>(original)->Program());
    if(prog != nullptr) {
        prog->SetProgramModified(true);
    }
}
    auto kindE2p = E2pToIrVariableDeclarationKind(kind);
    auto *allocatorE2p = reinterpret_cast<Context *>(context)->allocator;
    ArenaVector<ir::VariableDeclarator *> declaratorsArenaVector {reinterpret_cast<Context *>(context)->allocator->Adapter()};
 	for (size_t i = 0; i < declaratorsLen; ++i) {
 		auto *declaratorsElement1 = declarators[i];
 		auto *declaratorsElement1E2p = reinterpret_cast<ir::VariableDeclarator *>(declaratorsElement1);

 		declaratorsArenaVector.push_back(declaratorsElement1E2p);
 	}
    auto *ctx = reinterpret_cast<Context *>(context);
    auto *ctxAllocator = ctx->allocator;
    auto newE2pNode =  ctxAllocator->New<ir::VariableDeclaration>(kindE2p, allocatorE2p, std::move(declaratorsArenaVector));
    auto *e2pOriginal = reinterpret_cast<ir::AstNode *>(original);
    newE2pNode->SetOriginalNode(e2pOriginal);
