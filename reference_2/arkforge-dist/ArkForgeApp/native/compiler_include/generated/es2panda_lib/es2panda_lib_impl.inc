extern "C" __attribute__((unused)) Es2pandaMethodDefinitionKind IrToE2pMethodDefinitionKind(ir::MethodDefinitionKind irFlags)
{
    switch(irFlags)
    {
    case ir::MethodDefinitionKind::NONE:
        return Es2pandaMethodDefinitionKind::METHOD_DEFINITION_KIND_NONE;
    case ir::MethodDefinitionKind::CONSTRUCTOR:
        return Es2pandaMethodDefinitionKind::METHOD_DEFINITION_KIND_CONSTRUCTOR;
    case ir::MethodDefinitionKind::METHOD:
        return Es2pandaMethodDefinitionKind::METHOD_DEFINITION_KIND_METHOD;
    case ir::MethodDefinitionKind::EXTENSION_METHOD:
        return Es2pandaMethodDefinitionKind::METHOD_DEFINITION_KIND_EXTENSION_METHOD;
    case ir::MethodDefinitionKind::GET:
        return Es2pandaMethodDefinitionKind::METHOD_DEFINITION_KIND_GET;
    case ir::MethodDefinitionKind::SET:
        return Es2pandaMethodDefinitionKind::METHOD_DEFINITION_KIND_SET;
    case ir::MethodDefinitionKind::EXTENSION_GET:
        return Es2pandaMethodDefinitionKind::METHOD_DEFINITION_KIND_EXTENSION_GET;
    case ir::MethodDefinitionKind::EXTENSION_SET:
        return Es2pandaMethodDefinitionKind::METHOD_DEFINITION_KIND_EXTENSION_SET;
    default:
        ES2PANDA_UNREACHABLE();
    }
}

extern "C" __attribute__((unused)) Es2pandaOverloadDeclFlags IrToE2pOverloadDeclFlags(ir::OverloadDeclFlags irFlags)
{
    Es2pandaOverloadDeclFlags e2pFlags {(Es2pandaOverloadDeclFlags)0U};
    e2pFlags = static_cast<Es2pandaOverloadDeclFlags>((irFlags & ir::OverloadDeclFlags::NONE) != 0 ? e2pFlags | Es2pandaOverloadDeclFlags::OVERLOAD_DECL_FLAGS_NONE : e2pFlags);
    e2pFlags = static_cast<Es2pandaOverloadDeclFlags>((irFlags & ir::OverloadDeclFlags::FUNCTION) != 0 ? e2pFlags | Es2pandaOverloadDeclFlags::OVERLOAD_DECL_FLAGS_FUNCTION : e2pFlags);
    e2pFlags = static_cast<Es2pandaOverloadDeclFlags>((irFlags & ir::OverloadDeclFlags::CLASS_METHOD) != 0 ? e2pFlags | Es2pandaOverloadDeclFlags::OVERLOAD_DECL_FLAGS_CLASS_METHOD : e2pFlags);
    e2pFlags = static_cast<Es2pandaOverloadDeclFlags>((irFlags & ir::OverloadDeclFlags::INTERFACE_METHOD) != 0 ? e2pFlags | Es2pandaOverloadDeclFlags::OVERLOAD_DECL_FLAGS_INTERFACE_METHOD : e2pFlags);
    return e2pFlags;
}

