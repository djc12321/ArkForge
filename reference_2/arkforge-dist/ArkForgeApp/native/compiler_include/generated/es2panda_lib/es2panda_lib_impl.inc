    case Es2pandaCompilationMode::COMPILATION_MODE_SIMULTANEOUS:
        return es2panda::CompilationMode::SIMULTANEOUS;
    case Es2pandaCompilationMode::COMPILATION_MODE_SIMULTANEOUS_INCREMENTAL:
        return es2panda::CompilationMode::SIMULTANEOUS_INCREMENTAL;
    default:
